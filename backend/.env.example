# Supabase Enterprise Configuration (HTTPS / TLS 1.2+ with sslmode=require)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Server-Side 256-bit Cryptographic Keys (NFR-02: Strictly backend-only)
AUTH_JWT_SECRET=replace-with-32-byte-hex-hmac-sha256-signing-secret
DATA_AES256_KEY=replace-with-64-char-hex-aes-256-gcm-encryption-key

# Database Connection (SQLAlchemy / Alembic)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

# Google Gemini API Key for OCR & Vision Extraction
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3-flash-preview

# Module 2 rubric draft generation (server-side only)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_RUBRIC_MODEL=qwen/qwen3.7-flash
# Total draft attempts, including the initial draft (1 to 3).
RUBRIC_MAX_ATTEMPTS=2
# Optional stronger model from the same provider, used on the final correction attempt.
RUBRIC_FALLBACK_MODEL=
# Enables teacher-authenticated review and durable LangGraph checkpoints.
# Use a PostgreSQL direct connection or session pooler with the rubric_review schema.
RUBRIC_REVIEW_DATABASE_URL=

# Password Recovery Email Service (Resend HTTPS API or SMTP fallback)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=ScriptX Security <onboarding@resend.dev>
FRONTEND_URL=http://localhost:3000
